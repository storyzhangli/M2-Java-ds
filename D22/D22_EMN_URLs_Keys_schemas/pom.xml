<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.ai.m2.ds</groupId>
        <artifactId>D22</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>D22_EMN_URLs_Keys_schemas</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--mybatis plus extension-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
        </dependency>
        <!-- 模板引擎，二选一：Velocity(传统) / Freemarker -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>2.3</version>
        </dependency>
        <!--分页插件扩展-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- ========== SpringBoot3 专用MP starter ========== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!--密文存储方案-->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <!-- Servlet Web 栈：锚定 Tomcat + Spring MVC，确保不被切换到 WebFlux 反应式容器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation：支撑 @NotBlank / @Size 等请求参数校验（Boot 3 Web 栈需单独引入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            AOP：D13 新增，提供 spring-aop + AspectJ Weaver，支撑 @Aspect 切面记录
            Controller 方法入参/返回/耗时/异常。版本由 spring-boot-starter-parent 统一管理，不写 <version>。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
            Spring AI DeepSeek 专用 Starter（D01 核心）：
            - 版本由父 POM import 的 spring-ai-bom:1.1.8 统一管理，此处不写 <version>；
            - 自动装配 DeepSeekChatModel（实现 ChatModel），读取 spring.ai.deepseek.* 属性；
            - 仅引入 DeepSeek，不引入 OpenAI 等其它模型 starter。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!--
            Spring AI DeepSeek 的流式路径使用 WebClient。Spring AI starter 只传递
            spring-webflux API，不传递可用的 Reactor Netty HTTP 连接器；显式补充客户端
            实现，服务端仍由 spring-boot-starter-web 锚定为 MVC/Tomcat。
            版本由 Spring Boot 3.5.16 的依赖管理统一控制。
        -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
        </dependency>

        <!-- Lombok：与既有统一返回体/DTO 风格保持一致，optional 不向下游传递 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试：含 JUnit 5、Mockito、AssertJ、Spring Test、MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                测试运行时激活 test profile：
                读取 application-test.yml，将历史默认归属覆盖为 ut-default，
                避免未带头的测试请求写入 dev-user 的手工演示数据。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                        <app.ai.mode>mock</app.ai.mode>
                        <!--
                            测试永远使用显式无效的占位密钥，覆盖宿主环境中可能已存在的真实
                            DEEPSEEK_API_KEY。这样单元测试既不依赖真实凭据，也不会把环境值
                            写入 Surefire 报告；真实调用只能由独立、人工授权的外部流程发起。
                        -->
                        <spring.ai.deepseek.api-key>d01-mock-key-not-for-authentication</spring.ai.deepseek.api-key>
                    </systemPropertyVariables>
                    <!--
                        仅在测试 JVM 中使用受控 JDK 原生库路径。宿主 PATH 属于外部环境，
                        可能意外包含敏感参数；Surefire XML 会记录 java.library.path，
                        因此测试进程不继承不可控的 PATH 派生值。
                    -->
                    <argLine>-Djava.library.path=${java.home}/bin</argLine>
                    <environmentVariables>
                        <AI_MODE>mock</AI_MODE>
                        <DEEPSEEK_API_KEY>d01-mock-key-not-for-authentication</DEEPSEEK_API_KEY>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>